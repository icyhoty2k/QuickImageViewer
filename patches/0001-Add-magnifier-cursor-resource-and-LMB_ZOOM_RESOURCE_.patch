From 204a913baa8f8293fd1901add18d6bc9708beac2 Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Thu, 9 Jul 2026 11:22:23 +0000
Subject: [PATCH] Add magnifier cursor resource and LMB_ZOOM_RESOURCE_ID
 constant
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- resources/zoom_cursor.cur: generated 32x32 magnifier cursor binary
  (circle lens + diagonal handle, hotspot at lens center 10,10)
- resources/resource.h: add #define IDC_ZOOM_CURSOR 201
- resources/resource.rc: register zoom_cursor.cur as IDC_ZOOM_CURSOR
- Constants::Cursors: replace LMB_ZOOM WORD with LMB_ZOOM_RESOURCE_ID
  int(201) — loaded via LoadCursorW(hInstance,...) not LoadCursorW(null,...)
---
 resources/resource.h      |   3 ++-
 resources/resource.rc     |   3 ++-
 resources/zoom_cursor.cur | Bin 0 -> 326 bytes
 src/Platform/Constants.h  |   6 +++---
 4 files changed, 7 insertions(+), 5 deletions(-)
 create mode 100644 resources/zoom_cursor.cur

diff --git a/resources/resource.h b/resources/resource.h
index b9c354f..bd90371 100644
--- a/resources/resource.h
+++ b/resources/resource.h
@@ -1,2 +1,3 @@
 #pragma once
-#define IDI_APP_ICON 101
+#define IDI_APP_ICON    101
+#define IDC_ZOOM_CURSOR 201
diff --git a/resources/resource.rc b/resources/resource.rc
index 1df5ec4..df20356 100644
--- a/resources/resource.rc
+++ b/resources/resource.rc
@@ -1,4 +1,5 @@
 #include "resource.h"
 
 // The icon is in the same folder as this .rc file, so this is fine:
-IDI_APP_ICON ICON "QIV.ico"
+IDI_APP_ICON    ICON   "QIV.ico"
+IDC_ZOOM_CURSOR CURSOR "zoom_cursor.cur"
diff --git a/resources/zoom_cursor.cur b/resources/zoom_cursor.cur
new file mode 100644
index 0000000000000000000000000000000000000000..e7c1a07e2cf850e4014d6b830f271cd72c7741ae
GIT binary patch
literal 326
zcmchRF%E+;5CqquKuSZG)|8a|fc%VfDftpn9uhx+(gk9&Rz!tFnOm)Vy7B5xx+th^
zrK{Bk=_aYOJ<{C{)>#2(_%F;i?DcUo*)?nxtbTI?ON2DQJi@~ykX5m$CK<oh$a{-C
VX&gSP%nL97QXZTeo&Rm{F1~rYWaj_?

literal 0
HcmV?d00001

diff --git a/src/Platform/Constants.h b/src/Platform/Constants.h
index 25a0678..d890e5e 100644
--- a/src/Platform/Constants.h
+++ b/src/Platform/Constants.h
@@ -205,9 +205,9 @@ namespace Constants {
     // Use as: LoadCursor(nullptr, MAKEINTRESOURCEW(Constants::Cursors::LMB_ZOOM))
     // Change these to any other OCR_* value to swap the cursor for each mode.
     namespace Cursors {
-        constexpr WORD LMB_ZOOM = 32515; // IDC_CROSS  — LMB will 3x zoom
-        constexpr WORD LMB_PAN = 32649; // IDC_HAND   — LMB will pan
+        constexpr int  LMB_ZOOM_RESOURCE_ID = 201; // IDC_ZOOM_CURSOR — magnifier .cur embedded in binary
+        constexpr WORD LMB_PAN  = 32649; // IDC_HAND   — LMB will pan
         constexpr WORD RMB_DOWN = 32512; // IDC_ARROW  — RMB is held
-        constexpr WORD DEFAULT = 32512; // IDC_ARROW  — restored after action
+        constexpr WORD DEFAULT  = 32512; // IDC_ARROW  — restored after action
     }
 }
