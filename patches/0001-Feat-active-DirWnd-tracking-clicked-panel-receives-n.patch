@@ -70,6 +70,8 @@ namespace UI {
         if (m_hWnd && IsWindowVisible(m_hWnd)) {
             ShowWindow(m_hWnd, SW_HIDE);
             uiManager.OnPanelHidden(this);
+            // If this was the active dir panel, clear it so we fall back to F5.
