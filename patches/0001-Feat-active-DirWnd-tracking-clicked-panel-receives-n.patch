         }
     }
 
@@ -497,6 +499,8 @@ namespace UI {
 
             // -----------------------------------------------------------------
             case WM_LBUTTONDOWN: {
+                // Any click in a DirWnd makes it the active one for nav updates.
+                if (IsDirPanel()) uiManager.SetActiveDirWnd(this);
                 s_clickPos.x = GET_X_LPARAM(lParam);
                 s_clickPos.y = GET_Y_LPARAM(lParam);
