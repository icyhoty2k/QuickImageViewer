From b065a254292a1b31cead4aeb0c1f4568fdd54579 Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Sat, 11 Jul 2026 12:33:04 +0000
Subject: [PATCH] Fix: spawned DirWnd thumbnails, overlap, and focus

Three bugs fixed:

1. No thumbnails in spawned windows:
   UpdateDirView() was called before Show(), so IsWindowVisible()
   returned false and UpdateView() bailed immediately. Fix: use
   SW_SHOWNOACTIVATE to make window visible first, then UpdateDirView().

2. Spawned windows overlapping each other:
   All SpawnedDirWnd instances shared the Win32 class name
   QIV_SpawnedDirWindow. RegisterClassW succeeds only for the first
   registration; subsequent calls silently fail/reuse it, so all three
   slots ended up creating windows at the position the first slot
   registered (left strip). Fix: each slot gets a unique class name
   (QIV_SpawnedDirWindow_0/1/2) via a slot-index constructor.

3. Focus leaving HistoryListWnd after Shift+Enter:
   target->Show() called SetForegroundWindow on the spawned panel.
   Fix: SpawnDirWndForFolder now takes HWND hHistoryWnd and restores
   focus there after showing the panel. HistoryListWnd passes m_hWnd.
---
 src/UI/DirWnd.h           | 22 ++++++++++++++++++----
 src/UI/HistoryListWnd.cpp |  5 ++---
 src/UI/UIManager.cpp      | 23 +++++++++++++++--------
 src/UI/UIManager.h        |  2 +-
 4 files changed, 36 insertions(+), 16 deletions(-)

diff --git a/src/UI/DirWnd.h b/src/UI/DirWnd.h
index b89f2dd..961028d 100644
--- a/src/UI/DirWnd.h
+++ b/src/UI/DirWnd.h
@@ -44,8 +44,11 @@ namespace UI {
     // =========================================================================
     class SpawnedDirWnd : public DirWnd {
         public:
-            // Scan folderPath and fill m_localPlaylist.
-            // Call before Show() / UpdateDirView().
+            // slot: 0=left, 1=right, 2=center — used for a unique Win32 class name
+            // so each instance registers its own WNDCLASS and gets its own HWND
+            // without colliding with the primary DirWnd or each other.
+            explicit SpawnedDirWnd(int slot) : m_slot(slot) {}
+
             void LoadFolder(const std::wstring &folderPath) {
                 m_localPlaylist.clear();
                 std::filesystem::path dir(folderPath);
@@ -63,12 +66,23 @@ namespace UI {
             std::vector<std::wstring> GetSourceItems() const override { return m_localPlaylist; }
             bool HasOwnPlaylist() const override { return true; }
 
-            // Unique Win32 class name so RegisterClassW doesn't collide with DirWnd.
-            const wchar_t *ClassName()   const override { return L"QIV_SpawnedDirWindow"; }
+            // Each slot gets a unique Win32 class name so RegisterClassW doesn't
+            // silently reuse the first registration for all three slots.
+            const wchar_t *ClassName() const override {
+                // Static storage per slot — safe because slot values are 0/1/2.
+                static const wchar_t *names[] = {
+                    L"QIV_SpawnedDirWindow_0",
+                    L"QIV_SpawnedDirWindow_1",
+                    L"QIV_SpawnedDirWindow_2"
+                };
+                return names[m_slot < 3 ? m_slot : 0];
+            }
+
             const wchar_t *WindowTitle() const override { return L"Directory (Spawned)"; }
 
         private:
             std::vector<std::wstring> m_localPlaylist;
+            int m_slot = 0;
     };
 
 } // namespace UI
diff --git a/src/UI/HistoryListWnd.cpp b/src/UI/HistoryListWnd.cpp
index 472f41d..eaa45a2 100644
--- a/src/UI/HistoryListWnd.cpp
+++ b/src/UI/HistoryListWnd.cpp
@@ -401,9 +401,8 @@ namespace UI {
                             bool shiftHeld = (GetKeyState(VK_SHIFT) & 0x8000) != 0;
                             if (shiftHeld) {
                                 // Shift+Enter — spawn a DirWnd for this folder.
-                                // History panel stays open so the user can
-                                // keep spawning more without re-opening it.
-                                uiManager.SpawnDirWndForFolder(folder);
+                                // Pass m_hWnd so focus is returned here after spawn.
+                                uiManager.SpawnDirWndForFolder(folder, m_hWnd);
                             } else {
                                 // Plain Enter — load folder in main viewer (original behaviour).
                                 ShowWindow(m_hWnd, SW_HIDE);
diff --git a/src/UI/UIManager.cpp b/src/UI/UIManager.cpp
index 3c000a3..59534cc 100644
--- a/src/UI/UIManager.cpp
+++ b/src/UI/UIManager.cpp
@@ -76,7 +76,7 @@ namespace UI {
     // playlist.  app.playlist and the main viewer are NOT touched.
     // The primary (F5) DirWnd is never touched here.
     // -------------------------------------------------------------------------
-    void UIManager::SpawnDirWndForFolder(const std::wstring &folderPath) {
+    void UIManager::SpawnDirWndForFolder(const std::wstring &folderPath, HWND hHistoryWnd) {
         int slot = m_nextSpawnSlot;
         m_nextSpawnSlot = (m_nextSpawnSlot + 1) % Constants::DIR_WND_MAX_INSTANCES;
 
@@ -85,19 +85,26 @@ namespace UI {
         SpawnedDirWnd *target = m_spawnedDirWnds[slot];
 
         if (target == nullptr) {
-            // First time this slot is used — allocate and initialise the window.
-            // Each SpawnedDirWnd calls ThumbnailPanelWnd::CreateDeviceResources()
-            // which creates its own independent swap chain — no slot index needed.
-            target = new SpawnedDirWnd();
+            target = new SpawnedDirWnd(slot);
             target->Init(m_hInstance, m_hMainWnd, position);
             m_spawnedDirWnds[slot] = target;
         }
 
-        // Fill the private playlist for this slot then refresh the panel.
-        // No OpenDirectory call — app.playlist and the main viewer are untouched.
         target->LoadFolder(folderPath);
+
+        // Show the window without stealing focus from HistoryListWnd.
+        // ShowWindow with SW_SHOWNOACTIVATE makes it visible without activating.
+        // UpdateDirView must be called after the window is visible so that
+        // IsWindowVisible() returns true inside UpdateView().
+        ShowWindow(target->GetHwnd(), SW_SHOWNOACTIVATE);
         target->UpdateDirView();
-        target->Show();
+
+        // Return keyboard focus to the history panel so the user can keep
+        // navigating and spawning more folders without re-opening it.
+        if (hHistoryWnd) {
+            SetForegroundWindow(hHistoryWnd);
+            SetFocus(hHistoryWnd);
+        }
     }
 
     // -------------------------------------------------------------------------
diff --git a/src/UI/UIManager.h b/src/UI/UIManager.h
index 2d719fb..e5e6f32 100644
--- a/src/UI/UIManager.h
+++ b/src/UI/UIManager.h
@@ -37,7 +37,7 @@ namespace UI {
             // Uses slots 0-2 in round-robin order (left, right, center).
             // If all 3 slots are already occupied the oldest one is reused.
             // The primary (F5) DirWnd is never touched.
-            void SpawnDirWndForFolder(const std::wstring &folderPath);
+            void SpawnDirWndForFolder(const std::wstring &folderPath, HWND hHistoryWnd);
 
             // Hide all 3 spawned DirWnd instances (called from HideAllPanelWindows).
             void HideAllSpawnedDirWnds();
