From 254ce746c714f0b03747e589b342234da348b834 Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Sat, 11 Jul 2026 12:08:07 +0000
Subject: [PATCH] Fix: Shift+Enter spawn DirWnd - use SpawnedDirWnd with own
 playlist

Root cause: SpawnDirWndForFolder called OpenDirectory which replaces
app.playlist and changes the main viewer - wrong on both counts.

Fix:
- Add SpawnedDirWnd subclass of DirWnd (DirWnd.h):
  * Holds m_localPlaylist independent of app.playlist
  * LoadFolder() scans dir and fills m_localPlaylist directly
  * GetSourceItems() returns m_localPlaylist (not app.playlist)
  * HasOwnPlaylist() returns true
  * Unique ClassName() QIV_SpawnedDirWindow for Win32 WNDCLASS

- Add HasOwnPlaylist() virtual hook to ThumbnailPanelWnd (default false)
  UpdateView() skips the app.playlist-empty guard when true, so spawned
  windows can display content even when no image is loaded in main viewer.

- UIManager: SpawnDirWndForFolder now allocates SpawnedDirWnd, calls
  LoadFolder() then UpdateDirView() - no OpenDirectory, no app.playlist
  mutation, no main viewer interference.

- Remove unused FileHandler.h include from UIManager.cpp.

Clicking a thumbnail in a spawned window: playlistIndex will be -1 for
all entries (they are not in app.playlistIndexMap), so ThumbnailPanelWnd
already routes the click to OpenSpecificImage - loads that file into the
main viewer correctly without further changes.
---
 src/UI/DirWnd.h              | 50 ++++++++++++++++++++++++++++++++++++
 src/UI/ThumbnailPanelWnd.cpp |  4 ++-
 src/UI/ThumbnailPanelWnd.h   |  6 +++++
 src/UI/UIManager.cpp         | 17 +++++-------
 src/UI/UIManager.h           |  2 +-
 5 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/src/UI/DirWnd.h b/src/UI/DirWnd.h
index edc50a3..4dd5247 100644
--- a/src/UI/DirWnd.h
+++ b/src/UI/DirWnd.h
@@ -3,8 +3,10 @@
 #include <windows.h>
 #include <vector>
 #include <string>
+#include <filesystem>
 #include "ThumbnailPanelWnd.h"
 #include "Thumbnail.h"
+#include "../Platform/FileHandler.h"
 
 namespace UI {
     class DirWnd : public ThumbnailPanelWnd {
@@ -55,4 +57,52 @@ namespace UI {
 
             void PostBuildHook() override; // async decodes + legacy global sync
     };
+    // =========================================================================
+    // SpawnedDirWnd
+    //
+    // A DirWnd variant spawned from HistoryListWnd (Shift+Enter).
+    // Owns its own playlist so it never touches app.playlist.
+    // Clicking a thumbnail calls OpenSpecificImage (via playlistIndex=-1 path
+    // in ThumbnailPanelWnd) which loads that file into the main viewer.
+    // =========================================================================
+    class SpawnedDirWnd : public DirWnd {
+        public:
+            // Scan folderPath and store the image list in m_localPlaylist.
+            // Call before Show() / UpdateDirView().
+            void LoadFolder(const std::wstring &folderPath) {
+                m_localPlaylist.clear();
+                std::filesystem::path dir(folderPath);
+                if (!std::filesystem::exists(dir) || !std::filesystem::is_directory(dir))
+                    return;
+                for (const auto &entry : std::filesystem::directory_iterator(dir)) {
+                    if (!entry.is_regular_file()) continue;
+                    if (!is_image_ext(entry.path().extension().wstring())) continue;
+                    m_localPlaylist.push_back(std::filesystem::canonical(entry.path()).wstring());
+                }
+                // Sort alphabetically to match the primary DirWnd order.
+                std::sort(m_localPlaylist.begin(), m_localPlaylist.end());
+            }
+
+        protected:
+            // Return our private list instead of app.playlist.
+            std::vector<std::wstring> GetSourceItems() const override {
+                return m_localPlaylist;
+            }
+
+            // Tell ThumbnailPanelWnd::UpdateView to skip the app.playlist guard.
+            bool HasOwnPlaylist() const override { return true; }
+
+            // Use a unique class name so Win32 registers a separate WNDCLASS.
+            const wchar_t *ClassName() const override {
+                return L"QIV_SpawnedDirWindow";
+            }
+
+            const wchar_t *WindowTitle() const override {
+                return L"Directory (Spawned)";
+            }
+
+        private:
+            std::vector<std::wstring> m_localPlaylist;
+    };
+
 } // namespace UI
diff --git a/src/UI/ThumbnailPanelWnd.cpp b/src/UI/ThumbnailPanelWnd.cpp
index d687eb4..97f7760 100644
--- a/src/UI/ThumbnailPanelWnd.cpp
+++ b/src/UI/ThumbnailPanelWnd.cpp
@@ -116,7 +116,9 @@ namespace UI {
 
         m_thumbnails.clear();
 
-        if (app.playlist.empty() || app.currentIndex < 0) {
+        // Spawned DirWnd instances own their own playlist and bypass this guard.
+        // Primary DirWnd and CacheWnd still require app.playlist to be populated.
+        if (!HasOwnPlaylist() && (app.playlist.empty() || app.currentIndex < 0)) {
             InvalidateRect(m_hWnd, nullptr, TRUE);
             return;
         }
diff --git a/src/UI/ThumbnailPanelWnd.h b/src/UI/ThumbnailPanelWnd.h
index 1c8e806..e2083dd 100644
--- a/src/UI/ThumbnailPanelWnd.h
+++ b/src/UI/ThumbnailPanelWnd.h
@@ -103,6 +103,12 @@ namespace UI {
             // Base class calls this inside UpdateView() and handles all layout math.
             virtual std::vector<std::wstring> GetSourceItems() const = 0;
 
+            // Override to true when the subclass maintains its own playlist
+            // independent of app.playlist (e.g. SpawnedDirWnd).
+            // When true, UpdateView() skips the app.playlist-empty guard so
+            // the panel can display content even when no image is loaded.
+            virtual bool HasOwnPlaylist() const { return false; }
+
             // Called after thumbnails are built (e.g. DirWnd queues async decodes)
             virtual void PostBuildHook() {}
 
diff --git a/src/UI/UIManager.cpp b/src/UI/UIManager.cpp
index 908eb40..034ac97 100644
--- a/src/UI/UIManager.cpp
+++ b/src/UI/UIManager.cpp
@@ -1,5 +1,4 @@
 #include "UIManager.h"
-#include "../Platform/FileHandler.h"
 
 UI::UIManager uiManager;
 
@@ -73,7 +72,8 @@ namespace UI {
     //
     // Called by HistoryListWnd when the user presses Shift+Enter on a row.
     // Assigns the next round-robin slot (0=left, 1=right, 2=center), allocates
-    // the DirWnd on first use, and loads the requested folder into it.
+    // a SpawnedDirWnd on first use, and loads the folder into its private
+    // playlist.  app.playlist and the main viewer are NOT touched.
     // The primary (F5) DirWnd is never touched here.
     // -------------------------------------------------------------------------
     void UIManager::SpawnDirWndForFolder(const std::wstring &folderPath) {
@@ -82,22 +82,19 @@ namespace UI {
 
         int8_t position = Constants::DIR_WND_SPAWN_POSITIONS[slot];
 
-        DirWnd *target = m_spawnedDirWnds[slot];
+        SpawnedDirWnd *target = m_spawnedDirWnds[slot];
 
         if (target == nullptr) {
             // First time this slot is used — allocate and initialise the window.
-            target = new DirWnd();
+            target = new SpawnedDirWnd();
             target->Init(m_hInstance, m_hMainWnd, position);
             m_spawnedDirWnds[slot] = target;
         }
 
-        // Load the chosen folder into this DirWnd instance.
-        // OpenDirectory updates app.playlist then calls UpdateDirView on the
-        // primary window via the callback — the spawned window needs its own
-        // explicit update after the playlist is ready.
-        OpenDirectory(m_hMainWnd, folderPath);
+        // Fill the private playlist for this slot then refresh the panel.
+        // No OpenDirectory call — app.playlist and the main viewer are untouched.
+        target->LoadFolder(folderPath);
         target->UpdateDirView();
-        target->SyncDirSelectionRectangle();
         target->Show();
     }
 
diff --git a/src/UI/UIManager.h b/src/UI/UIManager.h
index 68eb755..2d719fb 100644
--- a/src/UI/UIManager.h
+++ b/src/UI/UIManager.h
@@ -57,7 +57,7 @@ namespace UI {
             // Slot 1 → right (position 2)
             // Slot 2 → center floating (position 0)
             // Pointers are nullptr until first use; memory owned here.
-            std::array<DirWnd *, Constants::DIR_WND_MAX_INSTANCES> m_spawnedDirWnds = {nullptr, nullptr, nullptr};
+            std::array<SpawnedDirWnd *, Constants::DIR_WND_MAX_INSTANCES> m_spawnedDirWnds = {nullptr, nullptr, nullptr};
 
             // Index of the next slot to use (round-robin, 0-2).
             int m_nextSpawnSlot = 0;
