From c288c90cdd8d794f6c0e58fbe4ca5a4d7a723d19 Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Fri, 10 Jul 2026 22:01:42 +0000
Subject: [PATCH] Fix folderHistory persistence: save 1000, display 10

- PushFolderHistory: trim to HISTORY_MAX_DIRS_TO_SAVE (1000) not
  HISTORY_MAX_DIRS_TO_SHOW (10). The display limit and the storage
  limit are different things; capping at 10 on every push was silently
  discarding all but the most recent 10 folders.

- LoadHistoryFromDisk: cap loaded lines at HISTORY_MAX_DIRS_TO_SAVE
  so a hand-edited or corrupted qivHistory.txt cannot grow the in-
  memory vector beyond the configured limit.

- WM_PAINT / GetHistoryWindowBounds / WM_KEYDOWN: clamp iteration and
  navigation to HISTORY_MAX_DIRS_TO_SHOW (10). folderHistory now holds
  up to 1000 entries but the panel renders and navigates only the top
  10. Computed as visibleCount / navMax before use.

- Title updated to 'showing N of M saved' so the user can see how many
  folders are stored vs. how many are visible.

- Remove dangling extern HistoryFoldersManager historyFoldersManager
  from HistoryFoldersManager.h. There was never a matching definition
  in the .cpp; the only real instance is the file-scope static inside
  the UI namespace in HistoryListWnd.cpp. Leaving an extern with no
  definition is an ODR violation waiting to happen.
---
 src/Persistence/HistoryFoldersManager.cpp |  4 ++
 src/Persistence/HistoryFoldersManager.h   |  2 -
 src/UI/HistoryListWnd.cpp                 | 46 ++++++++++++++++-------
 3 files changed, 37 insertions(+), 15 deletions(-)

diff --git a/src/Persistence/HistoryFoldersManager.cpp b/src/Persistence/HistoryFoldersManager.cpp
index 0122f73..46ec956 100644
--- a/src/Persistence/HistoryFoldersManager.cpp
+++ b/src/Persistence/HistoryFoldersManager.cpp
@@ -78,11 +78,15 @@ void HistoryFoldersManager::LoadHistoryFromDisk() {
         }
 
         // Parse Line 2+: Folder History
+        // Cap at HISTORY_MAX_DIRS_TO_SAVE so a hand-edited or corrupted file
+        // cannot bloat the in-memory vector beyond the configured limit.
         while (std::getline(file, line)) {
             if (!line.empty() && line.back() == L'\r') {
                 line.pop_back();
             }
             if (!line.empty()) {
+                if (static_cast<int>(folderHistory.size()) >= Constants::History::HISTORY_MAX_DIRS_TO_SAVE)
+                    break;
                 folderHistory.push_back(line);
             }
         }
diff --git a/src/Persistence/HistoryFoldersManager.h b/src/Persistence/HistoryFoldersManager.h
index 18cbc6e..9b4ba25 100644
--- a/src/Persistence/HistoryFoldersManager.h
+++ b/src/Persistence/HistoryFoldersManager.h
@@ -21,5 +21,3 @@ struct HistoryFoldersManager {
     // Reads the text file from disk and populates this struct's variables
     void LoadHistoryFromDisk();
 };
-
-extern HistoryFoldersManager historyFoldersManager;
diff --git a/src/UI/HistoryListWnd.cpp b/src/UI/HistoryListWnd.cpp
index 634e2bc..3aa9e81 100644
--- a/src/UI/HistoryListWnd.cpp
+++ b/src/UI/HistoryListWnd.cpp
@@ -41,8 +41,10 @@ namespace UI {
 
         history.insert(history.begin(), folderPath);
 
-        if (history.size() > Constants::History::HISTORY_MAX_DIRS_TO_SHOW)
-            history.resize(Constants::History::HISTORY_MAX_DIRS_TO_SHOW);
+        // Keep at most HISTORY_MAX_DIRS_TO_SAVE entries in memory.
+        // HISTORY_MAX_DIRS_TO_SHOW is only the display limit used in WM_PAINT.
+        if (static_cast<int>(history.size()) > Constants::History::HISTORY_MAX_DIRS_TO_SAVE)
+            history.resize(static_cast<size_t>(Constants::History::HISTORY_MAX_DIRS_TO_SAVE));
 
         // Immediately save state to disk
         historyFoldersManager.SaveHistoryToDisk();
@@ -69,7 +71,11 @@ namespace UI {
         int rowH = MulDiv(Constants::History::HISTORY_ROW_HEIGHT, dpi, 96);
         int padding = MulDiv(Constants::History::HISTORY_PADDING, dpi, 96);
 
-        int entries = std::max(1, static_cast<int>(historyFoldersManager.folderHistory.size()));
+        // Window height is based on the display limit, not the full saved history
+        int displayCount = std::min(
+            static_cast<int>(historyFoldersManager.folderHistory.size()),
+            Constants::History::HISTORY_MAX_DIRS_TO_SHOW);
+        int entries = std::max(1, displayCount);
         int totalH = padding * 2
                      + MulDiv(30, dpi, 96) // title row
                      + MulDiv(8, dpi, 96) // gap below title
@@ -115,11 +121,21 @@ namespace UI {
                         DEFAULT_CHARSET, OUT_OUTLINE_PRECIS, CLIP_DEFAULT_PRECIS,
                         CLEARTYPE_QUALITY, VARIABLE_PITCH, L"Segoe UI");
 
+                // Compute display count before drawing the title so it can reference it.
+                // folderHistory may hold up to HISTORY_MAX_DIRS_TO_SAVE entries;
+                // the panel only shows HISTORY_MAX_DIRS_TO_SHOW at once.
+                const auto &history = historyFoldersManager.folderHistory;
+                int visibleCount = std::min(
+                    static_cast<int>(history.size()),
+                    Constants::History::HISTORY_MAX_DIRS_TO_SHOW);
+
                 SelectObject(hdc, hTitleFont);
                 SetTextColor(hdc, RGB(100, 200, 255));
 
-                std::wstring title = L"Folder History  (last "
-                                     + std::to_wstring(Constants::History::HISTORY_MAX_DIRS_TO_SHOW) + L" folders)";
+                // Show "showing 10 of 247 saved" so the user knows there are more
+                std::wstring title = L"Folder History  (showing "
+                                     + std::to_wstring(visibleCount) + L" of "
+                                     + std::to_wstring(static_cast<int>(history.size())) + L" saved)";
                 RECT titleRect = {
                     rc.left + padding, rc.top + padding,
                     rc.right - padding, rc.top + padding + titleSz + 4
@@ -138,15 +154,13 @@ namespace UI {
                 g_rowRects.clear();
                 int y = sepY + MulDiv(6, dpi, 96);
 
-                const auto &history = historyFoldersManager.folderHistory;
-
                 if (history.empty()) {
                     SetTextColor(hdc, RGB(100, 100, 100));
                     RECT emptyRect = {rc.left + padding, y, rc.right - padding, y + rowH};
                     DrawTextW(hdc, L"No folders visited yet.", -1, &emptyRect,
                               DT_LEFT | DT_VCENTER | DT_SINGLELINE);
                 } else {
-                    for (int i = 0; i < static_cast<int>(history.size()); ++i) {
+                    for (int i = 0; i < visibleCount; ++i) {
                         RECT rowRect = {rc.left, y, rc.right, y + rowH};
                         g_rowRects.push_back(rowRect);
 
@@ -233,15 +247,21 @@ namespace UI {
 
             case WM_KEYDOWN: {
                 const auto &history = historyFoldersManager.folderHistory;
+                // Keyboard navigation is scoped to visible rows only.
+                // The panel draws HISTORY_MAX_DIRS_TO_SHOW entries even though
+                // folderHistory may hold up to HISTORY_MAX_DIRS_TO_SAVE.
+                int navMax = std::min(
+                    static_cast<int>(history.size()),
+                    Constants::History::HISTORY_MAX_DIRS_TO_SHOW);
                 switch (wParam) {
                     case Shortcuts::SC_PANEL_HISTORY_TOGGLE:
                         ToggleHistoryWindow();
                         return 0;
 
                     case VK_UP: {
-                        if (!history.empty()) {
+                        if (navMax > 0) {
                             g_hoverRow = (g_hoverRow <= 0)
-                                             ? static_cast<int>(history.size()) - 1
+                                             ? navMax - 1
                                              : g_hoverRow - 1;
                             InvalidateRect(m_hWnd, nullptr, FALSE);
                         }
@@ -249,8 +269,8 @@ namespace UI {
                     }
 
                     case VK_DOWN: {
-                        if (!history.empty()) {
-                            g_hoverRow = (g_hoverRow < static_cast<int>(history.size()) - 1)
+                        if (navMax > 0) {
+                            g_hoverRow = (g_hoverRow < navMax - 1)
                                              ? g_hoverRow + 1
                                              : 0;
                             InvalidateRect(m_hWnd, nullptr, FALSE);
@@ -259,7 +279,7 @@ namespace UI {
                     }
 
                     case VK_RETURN: {
-                        if (g_hoverRow >= 0 && g_hoverRow < static_cast<int>(history.size())) {
+                        if (g_hoverRow >= 0 && g_hoverRow < navMax) {
                             const std::wstring &folder = history[g_hoverRow];
                             ShowWindow(m_hWnd, SW_HIDE);
 
