From 495893faf3651702b51d8e356c10261b9e03285c Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Fri, 10 Jul 2026 22:09:54 +0000
Subject: [PATCH] Fix history not restored on startup: load data before first
 push

On startup the sequence was:
  UIManager::Init()          -- historyFoldersManager still empty
  OpenInitialImage()
    PushFolderHistory()      -- inserts 1 folder into empty vector
    SaveHistoryToDisk()      -- overwrites file with just 1 entry
  [user presses Tab]
  getHistoryListWindow()
    HistoryListWnd::Init()
      LoadHistoryFromDisk()  -- reads back only that 1 entry

All previously saved history was destroyed on every app start.

Fix: expose LoadFolderHistoryFromDisk() as a free function in the
UI namespace (same pattern as PushFolderHistory / GetFolderHistory)
and call it from UIManager::Init. No window is created -- just the
data is loaded into historyFoldersManager before any folder push
can clobber it.
---
 src/UI/HistoryListWnd.cpp | 4 ++++
 src/UI/HistoryListWnd.h   | 6 ++++++
 src/UI/UIManager.cpp      | 6 +++++-
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/src/UI/HistoryListWnd.cpp b/src/UI/HistoryListWnd.cpp
index 3aa9e81..b7da7ab 100644
--- a/src/UI/HistoryListWnd.cpp
+++ b/src/UI/HistoryListWnd.cpp
@@ -54,6 +54,10 @@ namespace UI {
         return historyFoldersManager.folderHistory;
     }
 
+    void LoadFolderHistoryFromDisk() {
+        historyFoldersManager.LoadHistoryFromDisk();
+    }
+
     // -------------------------------------------------------------------------
     // GetHistoryWindowBounds  —  centered on the parent's monitor
     // -------------------------------------------------------------------------
diff --git a/src/UI/HistoryListWnd.h b/src/UI/HistoryListWnd.h
index e90067c..debde17 100644
--- a/src/UI/HistoryListWnd.h
+++ b/src/UI/HistoryListWnd.h
@@ -49,4 +49,10 @@ namespace UI {
     void PushFolderHistory(const std::wstring &folderPath);
 
     const std::vector<std::wstring> &GetFolderHistory();
+
+    // Loads the saved folder history from disk into memory.
+    // Must be called once at startup (from UIManager::Init) BEFORE any
+    // PushFolderHistory call, otherwise the first folder push overwrites
+    // the file with a single entry and destroys all previously saved history.
+    void LoadFolderHistoryFromDisk();
 } // namespace UI
diff --git a/src/UI/UIManager.cpp b/src/UI/UIManager.cpp
index d5524ec..721e823 100644
--- a/src/UI/UIManager.cpp
+++ b/src/UI/UIManager.cpp
@@ -7,7 +7,11 @@ namespace UI {
         m_hInstance = hInstance;
         m_hMainWnd = hMainWnd;
 
-        // Init all panels once here so they are ready before first toggle
+        // Load saved folder history into memory before the first PushFolderHistory
+        // call that happens during startup image open. Without this, the vector is
+        // empty on the first push and SaveHistoryToDisk overwrites the file with
+        // a single entry, destroying all previously saved history.
+        LoadFolderHistoryFromDisk();
     }
 
     void UIManager::Show(IPanelWindow &panel) {
-- 
