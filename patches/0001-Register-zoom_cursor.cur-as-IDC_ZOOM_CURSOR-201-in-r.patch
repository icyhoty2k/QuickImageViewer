From b96226c53f94d9638da36d3c18821f40e1654d54 Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Thu, 9 Jul 2026 11:19:35 +0000
Subject: [PATCH] Register zoom_cursor.cur as IDC_ZOOM_CURSOR (201) in
 resources
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

resource.h: add #define IDC_ZOOM_CURSOR 201
resource.rc: add IDC_ZOOM_CURSOR CURSOR zoom_cursor.cur

The .cur file was already present in resources/ but was not compiled
into the binary — LoadCursorW(hInstance, MAKEINTRESOURCEW(201)) would
return null at runtime without this registration.
---
 resources/resource.h  | 3 ++-
 resources/resource.rc | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/resources/resource.h b/resources/resource.h
index b9c354f..bd90371 100644
--- a/resources/resource.h
+++ b/resources/resource.h
@@ -1,2 +1,3 @@
 #pragma once
-#define IDI_APP_ICON 101
+#define IDI_APP_ICON    101
+#define IDC_ZOOM_CURSOR 201
diff --git a/resources/resource.rc b/resources/resource.rc
index 1df5ec4..df20356 100644
--- a/resources/resource.rc
+++ b/resources/resource.rc
@@ -1,4 +1,5 @@
 #include "resource.h"
 
 // The icon is in the same folder as this .rc file, so this is fine:
-IDI_APP_ICON ICON "QIV.ico"
+IDI_APP_ICON    ICON   "QIV.ico"
+IDC_ZOOM_CURSOR CURSOR "zoom_cursor.cur"
-- 
2.43.0

