From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Wed, 8 Jul 2026 22:29:32 +0000
Subject: [PATCH] =?UTF-8?q?Fix=20MAKEINTRESOURCEW=20with=20ternary=20?=
 =?UTF-8?q?=E2=80=94=20extract=20WORD=20before=20macro?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

MAKEINTRESOURCEW(a ? b : c) fails because the ternary promotes
WORD operands to ULONG_PTR before the macro casts, which MSVC
rejects. Extract the ID into a local WORD first, then pass it.
---
 src/Input/MouseHandler.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/Input/MouseHandler.cpp b/src/Input/MouseHandler.cpp
index e74d9aa..07e37cf 100644
--- a/src/Input/MouseHandler.cpp
+++ b/src/Input/MouseHandler.cpp
@@ -95,8 +95,8 @@ void MouseHandler::HandleButtonDown(HWND hWnd, UINT message, LPARAM lParam) {
         bool imageOverflows = (renderW > winW + 0.5f) || (renderH > winH + 0.5f);
 
         // Show the appropriate cursor so the user knows what LMB will do.
-        SetCursor(LoadCursor(nullptr,
-            MAKEINTRESOURCEW(imageOverflows ? Constants::Cursors::LMB_PAN : Constants::Cursors::LMB_ZOOM)));
+        WORD cursorId = imageOverflows ? Constants::Cursors::LMB_PAN : Constants::Cursors::LMB_ZOOM;
+        SetCursor(LoadCursor(nullptr, MAKEINTRESOURCEW(cursorId)));
 
         // Save state so ButtonUp can restore if we zoomed.
         app.savedZoom    = app.viewport.zoom;
@@ -215,8 +215,8 @@ void MouseHandler::HandleMouseMove(HWND hWnd, LPARAM lParam) {
         InvalidateRect(hWnd, nullptr, FALSE);
     } else if (app.viewport.isDragging) {
         // Keep the appropriate cursor during drag (Windows resets it on every move).
-        SetCursor(LoadCursor(nullptr,
-            MAKEINTRESOURCEW(app.lmbDidZoom ? Constants::Cursors::LMB_ZOOM : Constants::Cursors::LMB_PAN)));
+        WORD cursorId = app.lmbDidZoom ? Constants::Cursors::LMB_ZOOM : Constants::Cursors::LMB_PAN;
+        SetCursor(LoadCursor(nullptr, MAKEINTRESOURCEW(cursorId)));
 
         POINT curMouse = {GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam)};
 
