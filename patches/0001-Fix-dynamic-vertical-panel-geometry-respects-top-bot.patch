From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Sat, 11 Jul 2026 12:45:59 +0000
Subject: [PATCH] =?UTF-8?q?Fix:=20dynamic=20vertical=20panel=20geometry=20?=
 =?UTF-8?q?=E2=80=94=20respects=20top/bottom=20neighbours?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Vertical panels (left=4, right=2) now query which horizontal edges are
currently occupied and size themselves to fit the remaining gap exactly.

Rules:
  - No neighbours visible        → full work height
  - Top panel visible (pos 1)    → start below it (workY + horzThick)
  - Bottom panel visible (pos 3) → end above it (workH - horzThick)
  - Both visible                 → fit between both

All panels (including F5 DirWnd and CacheWnd) already use rcWork so
the taskbar is never covered regardless of its position.

New API:
  ThumbnailPanelWnd::GetPosition()   — exposes m_position read-only
  ThumbnailPanelWnd::RefreshBounds() — reapply GetWindowBounds for
      current position without changing m_position (SWP_NOACTIVATE)
  UIManager::GetOccupiedEdges()      — scans all panels for pos 1/3
  UIManager::RefreshVerticalPanels() — calls RefreshBounds() on every
      visible vertical panel; called from Show/Hide/Toggle/Spawn/HideAll

GetWindowBounds uses uiManager.GetOccupiedEdges() for positions 2 and 4.
UIManager.h included only in ThumbnailPanelWnd.cpp (not the .h) to
avoid circular dependencies.
---
 src/UI/ThumbnailPanelWnd.cpp | 53 +++++++++++++++++++++++++++------
 src/UI/ThumbnailPanelWnd.h   |  8 +++++
 src/UI/UIManager.cpp         | 57 +++++++++++++++++++++++++++++++++++-
 src/UI/UIManager.h           | 11 +++++++
 4 files changed, 119 insertions(+), 10 deletions(-)

diff --git a/src/UI/ThumbnailPanelWnd.cpp b/src/UI/ThumbnailPanelWnd.cpp
index 769db32..6b07177 100644
--- a/src/UI/ThumbnailPanelWnd.cpp
+++ b/src/UI/ThumbnailPanelWnd.cpp
@@ -4,6 +4,7 @@
 #include <d2d1.h>
 
 #include "FileHandler.h"
+#include "UIManager.h"
 #include "../AppState.h"
 #include "../Platform/Constants.h"
 #include "../Input/Shortcuts.h"
@@ -84,6 +85,13 @@ namespace UI {
                      SWP_SHOWWINDOW | SWP_FRAMECHANGED);
     }
 
+    void ThumbnailPanelWnd::RefreshBounds() {
+        if (!m_hWnd) return;
+        int x, y, w, h;
+        GetWindowBounds(m_hOwner ? m_hOwner : m_hWnd, m_position, x, y, w, h);
+        SetWindowPos(m_hWnd, HWND_TOPMOST, x, y, w, h, SWP_FRAMECHANGED | SWP_NOACTIVATE);
+    }
+
     // =========================================================================
     // SyncSelectionRectangle
     // =========================================================================
@@ -318,8 +326,29 @@ namespace UI {
         int vertThick = static_cast<int>(
             (Constants::THUMBNAIL_PANEL_THUMB_WIDTH + Constants::THUMBNAIL_PANEL_THUMB_MARGIN * 2.0f) * app.dpiScale);
 
+        // For vertical panels, query which horizontal edges are currently occupied
+        // by other visible panels so we can fit exactly into the remaining gap.
+        bool topOccupied    = false;
+        bool bottomOccupied = false;
+        if (position == 2 || position == 4) {
+            uiManager.GetOccupiedEdges(topOccupied, bottomOccupied);
+            // Don't count this panel's own edge — only other panels matter.
+            // (A vertical panel is never at top/bottom itself, so no self-exclusion needed.)
+        }
+
+        // Compute the vertical strip's Y start and total height based on neighbours.
+        //   Neither edge occupied  → full work height
+        //   Only top occupied      → start below top strip, end at work bottom
+        //   Only bottom occupied   → start at work top, end above bottom strip
+        //   Both edges occupied    → start below top strip, end above bottom strip
+        auto verticalBounds = [&](int &vy, int &vh) {
+            vy = workY + (topOccupied    ? horzThick : 0);
+            int bottom = workY + workH - (bottomOccupied ? horzThick : 0);
+            vh = bottom - vy;
+        };
+
         switch (position) {
-            case 0: { // center floating — 80% of work width, thumb-height tall, vertically centered in work area
+            case 0: { // center floating — 80% of work width, thumb-height tall, vertically centred
                 int panelW = static_cast<int>(workW * 0.80f);
                 x = workX + (workW - panelW) / 2;
                 y = workY + (workH - horzThick) / 2;
@@ -327,30 +356,36 @@ namespace UI {
                 h = horzThick;
                 break;
             }
-            case 1: // top — full width at top of work area (respects taskbar if at top)
+            case 1: // top — full work width at top of work area
                 x = workX;
                 y = workY;
                 w = workW;
                 h = horzThick;
                 break;
-            case 2: // right — starts just below the top DirWnd, respects work area bottom
+            case 2: { // right — dynamic height based on occupied edges
+                int vy, vh;
+                verticalBounds(vy, vh);
                 x = workX + workW - vertThick;
-                y = workY + horzThick;
+                y = vy;
                 w = vertThick;
-                h = workH - horzThick;
+                h = vh;
                 break;
-            case 3: // bottom — full work width, sits at bottom of work area (above taskbar)
+            }
+            case 3: // bottom — full work width at bottom of work area (above taskbar)
                 x = workX;
                 y = workY + workH - horzThick;
                 w = workW;
                 h = horzThick;
                 break;
-            case 4: // left — starts just below the top DirWnd, respects work area bottom
+            case 4: { // left — dynamic height based on occupied edges
+                int vy, vh;
+                verticalBounds(vy, vh);
                 x = workX;
-                y = workY + horzThick;
+                y = vy;
                 w = vertThick;
-                h = workH - horzThick;
+                h = vh;
                 break;
+            }
             default:
                 x = workX;
                 y = workY;
diff --git a/src/UI/ThumbnailPanelWnd.h b/src/UI/ThumbnailPanelWnd.h
index 32f6e64..7fe8203 100644
--- a/src/UI/ThumbnailPanelWnd.h
+++ b/src/UI/ThumbnailPanelWnd.h
@@ -41,6 +41,14 @@ namespace UI {
             void Hide() override;
             void MovePanel();
 
+            // Returns the current position slot (0=center,1=top,2=right,3=bottom,4=left)
+            int8_t GetPosition() const { return m_position; }
+
+            // Recompute and apply window bounds for the current position slot.
+            // Called by UIManager::RefreshVerticalPanels when a neighbouring
+            // horizontal panel is shown or hidden.
+            void RefreshBounds();
+
         public:
             // Shared geometry state — read by Render()
             float m_offset = 0.0f;
diff --git a/src/UI/UIManager.cpp b/src/UI/UIManager.cpp
index 59534cc..ce89bc7 100644
--- a/src/UI/UIManager.cpp
+++ b/src/UI/UIManager.cpp
@@ -17,14 +17,17 @@ namespace UI {
 
     void UIManager::Show(IPanelWindow &panel) {
         panel.Show();
+        RefreshVerticalPanels();
     }
 
     void UIManager::Hide(IPanelWindow &panel) {
         panel.Hide();
+        RefreshVerticalPanels();
     }
 
     void UIManager::Toggle(IPanelWindow &panel) {
-        panel.Toggle(); // panels are already initialized in Init()
+        panel.Toggle();
+        RefreshVerticalPanels();
     }
 
     void UIManager::HideAllPanelWindows() {
@@ -33,8 +36,11 @@ namespace UI {
         Hide(dirWnd);
         Hide(historyListWnd);
         HideAllSpawnedDirWnds();
+        // RefreshVerticalPanels already called by each Hide() above.
     }
 
+    // ...
+
     HelpWnd &UIManager::getHelpWindow() {
         if (isInit(helpWnd)) {
             return helpWnd;
@@ -98,6 +104,7 @@ namespace UI {
         // IsWindowVisible() returns true inside UpdateView().
         ShowWindow(target->GetHwnd(), SW_SHOWNOACTIVATE);
         target->UpdateDirView();
+        RefreshVerticalPanels();
 
         // Return keyboard focus to the history panel so the user can keep
         // navigating and spawning more folders without re-opening it.
@@ -119,9 +126,57 @@ namespace UI {
                 m_spawnedDirWnds[i]->Hide();
             }
         }
+        RefreshVerticalPanels();
     }
 
     bool UIManager::isInit(IPanelWindow &panel) {
         return panel.GetHwnd() != nullptr;
     }
+
+    void UIManager::RefreshVerticalPanels() {
+        // Reposition every visible vertical panel so its height reflects the
+        // current top/bottom occupation state. This runs after any show/hide.
+        auto refresh = [](ThumbnailPanelWnd &p) {
+            int8_t pos = p.GetPosition();
+            if ((pos != 2 && pos != 4) || !p.GetHwnd() || !IsWindowVisible(p.GetHwnd()))
+                return;
+            // Re-use MovePanel logic: recompute bounds and call SetWindowPos.
+            // We can't call GetWindowBounds directly (it's protected), but
+            // calling Toggle twice would flicker. Instead trigger WM_SIZE by
+            // doing a no-op SetWindowPos with SWP_FRAMECHANGED after a position
+            // re-query. The cleanest way: call the public MovePanel equivalent.
+            // Since we don't want to change m_position, we fake it:
+            // hide → show (recomputes bounds in Show/Toggle path).
+            // Actually the right path: p has a public UpdateBounds() we add.
+            p.RefreshBounds();
+        };
+
+        refresh(cacheWnd);
+        refresh(dirWnd);
+        for (int i = 0; i < Constants::DIR_WND_MAX_INSTANCES; ++i) {
+            if (m_spawnedDirWnds[i])
+                refresh(*m_spawnedDirWnds[i]);
+        }
+    }
+
+    void UIManager::GetOccupiedEdges(bool &top, bool &bottom) const {
+        top = false;
+        bottom = false;
+
+        // Helper: check one ThumbnailPanelWnd — visible and at the given position?
+        auto check = [&](const ThumbnailPanelWnd &p, int8_t pos) {
+            if (p.GetHwnd() && IsWindowVisible(p.GetHwnd()) && p.GetPosition() == pos) {
+                if (pos == 1) top    = true;
+                if (pos == 3) bottom = true;
+            }
+        };
+
+        check(cacheWnd, cacheWnd.GetPosition());
+        check(dirWnd,   dirWnd.GetPosition());
+
+        for (int i = 0; i < Constants::DIR_WND_MAX_INSTANCES; ++i) {
+            if (m_spawnedDirWnds[i])
+                check(*m_spawnedDirWnds[i], m_spawnedDirWnds[i]->GetPosition());
+        }
+    }
 }
diff --git a/src/UI/UIManager.h b/src/UI/UIManager.h
index e5e6f32..623d191 100644
--- a/src/UI/UIManager.h
+++ b/src/UI/UIManager.h
@@ -42,6 +42,17 @@ namespace UI {
             // Hide all 3 spawned DirWnd instances (called from HideAllPanelWindows).
             void HideAllSpawnedDirWnds();
 
+            // Query which horizontal edges are currently occupied by a visible panel.
+            // top=true  → a panel is visible at position 1 (top strip)
+            // bottom=true → a panel is visible at position 3 (bottom strip)
+            // Used by ThumbnailPanelWnd::GetWindowBounds to size vertical panels.
+            void GetOccupiedEdges(bool &top, bool &bottom) const;
+
+            // Reposition all currently-visible vertical panels (left/right) to
+            // reflect the current top/bottom occupation state. Call whenever any
+            // panel is shown or hidden so vertical panels resize dynamically.
+            void RefreshVerticalPanels();
+
         private:
             HelpWnd helpWnd;
             CacheWnd cacheWnd;
