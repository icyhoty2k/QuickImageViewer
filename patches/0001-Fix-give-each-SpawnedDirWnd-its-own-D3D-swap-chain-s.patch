From b62e44034bc02ca9dc05c1ae8d2b569f222eb90f Mon Sep 17 00:00:00 2001
From: Ivan Hristov Yanev <icyhoty2k@gmail.com>
Date: Sat, 11 Jul 2026 12:18:09 +0000
Subject: [PATCH] Fix: give each SpawnedDirWnd its own D3D swap chain slot
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: all DirWnd subclasses returned ThumbnailPanelType::Dir so
every SpawnedDirWnd::Init called CreatePanelDeviceResources(Dir, newHwnd)
which overwrote m_dirPanel.swapChain — destroying the primary F5 DirWnd
swap chain and leaving it with a dead device context.

Fix:
- RendererD2D.h: extend ThumbnailPanelType enum with Spawned0/Spawned1/Spawned2.
  Add ThumbnailPanel m_spawnedPanels[3] alongside m_dirPanel.
  Update GetPanel() switch to dispatch Spawned0/1/2 to correct array slot.
  All existing CreatePanelDeviceResources/RenderPanel/ResizePanel/Discard
  calls work correctly with no changes — they all go through GetPanel().

- DirWnd.h (SpawnedDirWnd): add int m_slotIndex (default 0) and
  SetSlotIndex(). Override GetPanelType() to return Spawned0/1/2 based
  on m_slotIndex, giving each spawned window its own independent swap chain.

- UIManager.cpp: call target->SetSlotIndex(slot) before Init() so
  GetPanelType() returns the right type when CreateDeviceResources fires.
---
 src/Renderer/RendererD2D.h | 13 +++++++++++--
 src/UI/DirWnd.h            | 16 ++++++++++++++++
 src/UI/UIManager.cpp       |  4 ++++
 3 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/Renderer/RendererD2D.h b/src/Renderer/RendererD2D.h
index 587c241..4afc55c 100644
--- a/src/Renderer/RendererD2D.h
+++ b/src/Renderer/RendererD2D.h
@@ -60,7 +60,7 @@ class RendererD2D final : public IImageRenderer {
         // =====================================================================
         // Thumbnail Panel APIs (Cache & Dir Windows)
         // =====================================================================
-        enum class ThumbnailPanelType { Cache, Dir };
+        enum class ThumbnailPanelType { Cache, Dir, Spawned0, Spawned1, Spawned2 };
 
         HRESULT CreatePanelDeviceResources(ThumbnailPanelType type, HWND hwnd);
 
@@ -141,9 +141,18 @@ class RendererD2D final : public IImageRenderer {
 
         ThumbnailPanel m_cachePanel;
         ThumbnailPanel m_dirPanel;
+        // One independent D3D swap chain per spawned DirWnd slot (history Shift+Enter).
+        // Indexed 0-2, matching DIR_WND_SPAWN_POSITIONS slots.
+        ThumbnailPanel m_spawnedPanels[3];
 
         ThumbnailPanel &GetPanel(ThumbnailPanelType type) {
-            return type == ThumbnailPanelType::Cache ? m_cachePanel : m_dirPanel;
+            switch (type) {
+                case ThumbnailPanelType::Cache:    return m_cachePanel;
+                case ThumbnailPanelType::Spawned0: return m_spawnedPanels[0];
+                case ThumbnailPanelType::Spawned1: return m_spawnedPanels[1];
+                case ThumbnailPanelType::Spawned2: return m_spawnedPanels[2];
+                default:                           return m_dirPanel;
+            }
         }
 
         // Dir thumbnail cache  —  small scaled-down bitmaps for every file in
diff --git a/src/UI/DirWnd.h b/src/UI/DirWnd.h
index 4dd5247..9e13989 100644
--- a/src/UI/DirWnd.h
+++ b/src/UI/DirWnd.h
@@ -62,11 +62,17 @@ namespace UI {
     //
     // A DirWnd variant spawned from HistoryListWnd (Shift+Enter).
     // Owns its own playlist so it never touches app.playlist.
+    // Each slot gets its own renderer panel (Spawned0/1/2) so the primary
+    // DirWnd's D3D swap chain is never disturbed.
     // Clicking a thumbnail calls OpenSpecificImage (via playlistIndex=-1 path
     // in ThumbnailPanelWnd) which loads that file into the main viewer.
     // =========================================================================
     class SpawnedDirWnd : public DirWnd {
         public:
+            // Set before Init() — tells this instance which renderer slot to use.
+            // Valid values: 0, 1, 2  (matching DIR_WND_SPAWN_POSITIONS indices).
+            void SetSlotIndex(int slot) { m_slotIndex = slot; }
+
             // Scan folderPath and store the image list in m_localPlaylist.
             // Call before Show() / UpdateDirView().
             void LoadFolder(const std::wstring &folderPath) {
@@ -92,6 +98,15 @@ namespace UI {
             // Tell ThumbnailPanelWnd::UpdateView to skip the app.playlist guard.
             bool HasOwnPlaylist() const override { return true; }
 
+            // Each slot maps to its own renderer panel so swap chains don't collide.
+            RendererD2D::ThumbnailPanelType GetPanelType() const override {
+                switch (m_slotIndex) {
+                    case 0:  return RendererD2D::ThumbnailPanelType::Spawned0;
+                    case 1:  return RendererD2D::ThumbnailPanelType::Spawned1;
+                    default: return RendererD2D::ThumbnailPanelType::Spawned2;
+                }
+            }
+
             // Use a unique class name so Win32 registers a separate WNDCLASS.
             const wchar_t *ClassName() const override {
                 return L"QIV_SpawnedDirWindow";
@@ -103,6 +118,7 @@ namespace UI {
 
         private:
             std::vector<std::wstring> m_localPlaylist;
+            int m_slotIndex = 0;
     };
 
 } // namespace UI
diff --git a/src/UI/UIManager.cpp b/src/UI/UIManager.cpp
index 034ac97..99506e9 100644
--- a/src/UI/UIManager.cpp
+++ b/src/UI/UIManager.cpp
@@ -86,7 +86,11 @@ namespace UI {
 
         if (target == nullptr) {
             // First time this slot is used — allocate and initialise the window.
+            // SetSlotIndex must be called before Init so GetPanelType() returns
+            // the correct ThumbnailPanelType (Spawned0/1/2) when
+            // CreateDeviceResources is called inside Init.
             target = new SpawnedDirWnd();
+            target->SetSlotIndex(slot);
             target->Init(m_hInstance, m_hMainWnd, position);
             m_spawnedDirWnds[slot] = target;
         }
-- 
